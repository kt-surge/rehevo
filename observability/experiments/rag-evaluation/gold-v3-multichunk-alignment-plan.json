        "[EVIDENCE:P01:resume]",
        "[EVIDENCE:P01:answer]"
      ],
      "expectedEvidenceFacts": [
        {
          "marker": "[EVIDENCE:P01:resume]",
          "text": "把扣款记录与 Outbox 事件拆分为独立事务后，再由提交后投递保证顺序"
        },
        {
          "marker": "[EVIDENCE:P01:answer]",
          "text": "能先说明代理边界，再比较 REQUIRED 与 REQUIRES_NEW"
        }
